# Copy to .env and fill in. .env is gitignored; this template is tracked.

# --- Database ---------------------------------------------------------------
# Paste your provider's URL exactly as printed (Neon, Supabase, local Postgres).
# config.py rewrites the driver to asyncpg and translates libpq-only parameters
# (sslmode, channel_binding), so the console form works unchanged.
#   postgresql://user:pass@host/db?sslmode=require&channel_binding=require
# Blank => verifications fall back to a JSON file; submitted areas are disabled.
DATABASE_URL=

# --- LLM — Google AI Studio -------------------------------------------------
# Used through Google's OpenAI-compatible endpoint, so the OpenAI SDK is unchanged.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.0-flash-lite is RETIRED — the API 404s it. Default is
# gemini-3.5-flash-lite, which Google's own error names as the replacement.
GEMINI_MODEL=gemini-3.5-flash-lite
# One provider, so no fallback chain: a 429 is retried with exponential backoff
# (honouring Retry-After), then the caller degrades to its deterministic path.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0
# Bounds on one completion. LLM_REQUEST_TIMEOUT caps a single HTTP call (a
# free-tier endpoint under load can stall rather than refuse); LLM_TOTAL_BUDGET
# caps every attempt plus every backoff, so a rate-limited demo degrades to its
# deterministic answer instead of holding a web request open for minutes.
LLM_REQUEST_TIMEOUT=30.0
LLM_TOTAL_BUDGET=75.0

# --- Evidence corroboration / web search ------------------------------------
SEARCH_PROVIDER=tavily       # tavily | serper | none. Gemini has no `:online`
                             # equivalent, so results are fetched server-side.
SEARCH_API_KEY=              # required unless SEARCH_PROVIDER=none

# --- Google Earth Engine ----------------------------------------------------
# Personal OAuth refresh token — NOT a service account.
#
#   earthengine authenticate
#   cat ~/.config/earthengine/credentials
#
# Paste the whole JSON on ONE line in single quotes:
#   EARTHENGINE_CREDENTIALS_JSON='{"refresh_token":"...","client_id":"...","client_secret":"...","scopes":[...]}'
#
# This is your own Google identity and your own GEE quota, and it cannot be
# scoped down. Deliberate short-term substitution for a service account; see
# backend/app/core/gee_auth.py and the note in README.md.
#
# Used ONLY by the offline pipeline and the slow "process a new area" path.
# The live query path never calls Earth Engine.
EARTHENGINE_CREDENTIALS_JSON=
GEE_PROJECT_ID=

# --- CORS -------------------------------------------------------------------
# Comma-separated allowlist. Set to the deployed frontend origin. Never "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (frontend/.env) -----------------------------------------------
# VITE_API_BASE_URL=          # blank in dev (Vite proxies); the Render URL in prod
# VITE_MAPLIBRE_STYLE_URL=    # blank => built-in OpenStreetMap raster fallback

# --- Sessions (Neon Managed Better Auth) ------------------------------------
# Blank => API open, front door offers only "Continue as demo" (local state).
# On a deployment set both, plus VITE_NEON_AUTH_URL in frontend/.env.
NEON_AUTH_URL=
AUTH_REQUIRED=false
