# Copy to .env and fill in. .env is gitignored; this template is tracked.

# --- Database ---------------------------------------------------------------
# Paste your provider's URL exactly as printed (Neon, Supabase, local Postgres).
# config.py rewrites the driver to asyncpg and translates libpq-only parameters
# (sslmode, channel_binding), so the console form works unchanged.
#   postgresql://user:pass@host/db?sslmode=require&channel_binding=require
# Blank => verifications fall back to a JSON file; submitted areas are disabled.
DATABASE_URL=

# --- LLM — OpenRouter -------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=            # e.g. anthropic/claude-sonnet-4.5
OPENROUTER_SITE_URL=         # optional, sent as HTTP-Referer
OPENROUTER_APP_NAME=LoopSatellite   # sent as X-Title

# --- Evidence corroboration / web search ------------------------------------
SEARCH_PROVIDER=openrouter_online   # openrouter_online | tavily | serper | none
SEARCH_API_KEY=              # only needed if NOT using an OpenRouter :online model

# --- Google Earth Engine ----------------------------------------------------
# Personal OAuth refresh token — NOT a service account.
#
#   earthengine authenticate
#   cat ~/.config/earthengine/credentials
#
# Paste the whole JSON on ONE line in single quotes:
#   EARTHENGINE_CREDENTIALS_JSON='{"refresh_token":"...","client_id":"...","client_secret":"...","scopes":[...]}'
#
# This is your own Google identity and your own GEE quota, and it cannot be
# scoped down. Deliberate short-term substitution for a service account; see
# backend/app/core/gee_auth.py and the note in README.md.
#
# Used ONLY by the offline pipeline and the slow "process a new area" path.
# The live query path never calls Earth Engine.
EARTHENGINE_CREDENTIALS_JSON=
GEE_PROJECT_ID=

# --- CORS -------------------------------------------------------------------
# Comma-separated allowlist. Set to the deployed frontend origin. Never "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (frontend/.env) -----------------------------------------------
# VITE_API_BASE_URL=          # blank in dev (Vite proxies); the Render URL in prod
# VITE_MAPLIBRE_STYLE_URL=    # blank => built-in OpenStreetMap raster fallback
