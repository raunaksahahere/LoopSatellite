# Database
DATABASE_URL=postgresql+asyncpg://user:pass@your-neon-host/dbname

# LLM — OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=            # e.g. anthropic/claude-sonnet-4.5 — set later
OPENROUTER_SITE_URL=         # optional, for OpenRouter's HTTP-Referer header
OPENROUTER_APP_NAME=LoopSatellite   # sent as X-Title header

# Evidence corroboration / web search
SEARCH_API_KEY=              # only needed if NOT using an OpenRouter :online model
SEARCH_PROVIDER=openrouter_online   # openrouter_online | tavily | serper | none

# Google Earth Engine (offline data_pipeline only, not the live backend)
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_JSON=    # path to service account key, if using one

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_MAPLIBRE_STYLE_URL=     # e.g. a free MapLibre demo style or self-hosted style JSON
