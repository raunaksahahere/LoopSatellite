# Workspace-wide rules only. Each app owns its own build artefacts:
#   backend/.gitignore   Python, venv, pipeline intermediates, verifications
#   frontend/.gitignore  node_modules, Vite output
#   docs/.gitignore      generated documentation output

# --- Secrets ----------------------------------------------------------------
# Belt and braces: backend/ and frontend/ repeat these for their own .env files.
# .env.example is the template and must stay tracked.
.env
.env.*
!.env.example

# --- OS -----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Editors ----------------------------------------------------------------
.idea/
.vscode/
*.swp
*~

# --- Stray output -----------------------------------------------------------
*.log
